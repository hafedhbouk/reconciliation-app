# Ignore Git files
.git
.gitignore
.github

# Ignore environment files
.env
.env.*
!.env.example

# Ignore Docker files
docker-compose*.yml
Dockerfile*
.docker
.dockerignore

# Ignore Node modules and build artifacts
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore Laravel storage and cache
/storage/*.key
/storage/pail
/storage/app/samples
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*.log
/bootstrap/cache/*.php

# Ignore testing files
.phpunit.result.cache
.phpunit.cache
coverage
.nyc_output

# Ignore IDE and editor files
.idea
.vscode
*.swp
*.swo
*~
.DS_Store

# Ignore vendor directory (installed via Composer in container)
/vendor

# Ignore public assets built by Vite
/public/build
/public/hot
/public/storage

# Ignore documentation that shouldn't be in the image
docs/
*.md
LICENSE

# Ignore log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore temporary files
tmp/
temp/
*.tmp
*.temp
